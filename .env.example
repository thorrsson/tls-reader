NEXT_PUBLIC_TLS_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_TLS_AUTH_URL=http://localhost:8080/auth/login
NEXT_PUBLIC_TLS_CATALOG_URL=http://localhost:8080/opds/publications
NEXT_PUBLIC_TLS_BASE_READER_URL=

# Optional. Extra origins allowed to reach the dev server when it is bound to
# 0.0.0.0 for LAN testing (comma-separated hosts, no scheme). Only needed when
# running `next dev` on a LAN IP; leave unset for plain localhost development.
# ALLOWED_DEV_ORIGINS=192.168.1.50
