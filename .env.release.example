# Copy to .env.release, chmod 600 .env.release, and fill in real values.
# bash scripts/setup-release-secrets.sh --env-file .env.release --dry-run
# Remove --dry-run to upload to the existing protected release environment.
# Never commit real credentials. Values must fit on one line, with optional quotes.

# Developer ID Application certificate AND private key:
# base64 < certificate.p12 | tr -d '\n'
MACOS_CERTIFICATE_P12=
MACOS_CERTIFICATE_PASSWORD=
# Developer ID Application: Your Name (TEAMID)
MACOS_SIGNING_IDENTITY=

# App Store Connect notarization API key:
NOTARY_API_KEY_ID=
NOTARY_API_ISSUER_ID=
# base64 < AuthKey_KEYID.p8 | tr -d '\n'
NOTARY_API_KEY_P8=

# Optional: omit both for unsigned Windows releases (SmartScreen warnings may appear).
# If configuring signing, supply both; invalid credentials fail the release.
# Windows Authenticode certificate + private key, base64 .pfx/.p12, and password.
# Cloud/hardware signing providers require workflow integration instead.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Optional: iOS TestFlight releases (mobile workflow). Supply all three together.
# Uploads use the App Store Connect API key above (NOTARY_API_*); it needs at
# least the Developer role. Apple Distribution certificate AND private key:
# base64 < distribution.p12 | tr -d '\n'
IOS_DISTRIBUTION_CERTIFICATE_P12=
IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=
# App Store provisioning profile for com.tlslibrary.reader:
# base64 < TLS_Reader_App_Store.mobileprovision | tr -d '\n'
IOS_PROVISIONING_PROFILE=

# Optional: Google Play internal-track releases (mobile workflow). Supply all together.
# Upload key keystore: base64 < upload-keystore.jks | tr -d '\n'
ANDROID_UPLOAD_KEYSTORE=
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Play Console service account key: base64 < service-account.json | tr -d '\n'
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
